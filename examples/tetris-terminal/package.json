{
  "name": "@johnhenry/example-tetris-terminal",
  "version": "0.0.0",
  "private": true,
  "description": "Tetris driven by real Laya predictions in the terminal (Node/Bun; MLX, WebGPU or CPU), in the laya-snake demo's architecture",
  "type": "module",
  "exports": {
    "./core": "./src/core/index.ts"
  },
  "bin": {
    "laya-tetris-js": "./src/cli.ts"
  },
  "scripts": {
    "start": "node --conditions=source src/cli.ts",
    "start:bun": "bun --conditions=source src/cli.ts",
    "dev": "node --conditions=source src/cli.ts --max-speed",
    "bench": "node --conditions=source src/cli.ts --headless --episodes 4 --seed 101",
    "bench:bun": "bun --conditions=source src/cli.ts --headless --episodes 4 --seed 101",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && node --conditions=source --test test/*.test.ts",
    "test:bun": "bun --conditions=source test test/"
  },
  "dependencies": {
    "@johnhenry/laya": "^0.3.1",
    "@johnhenry/laya-core": "^0.1.1",
    "@johnhenry/hf-cache": "^0.1.2"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.2.0"
  },
  "devDependencies": {
    "@johnhenry/backend-webgpu": "^0.5.1"
  }
}
