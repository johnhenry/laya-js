{
  "name": "@johnhenry/laya-router",
  "version": "0.1.4",
  "description": "Language/task routing across Laya checkpoints",
  "keywords": [
    "laya",
    "router",
    "routing",
    "language-detection",
    "multilingual"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/johnhenry/laya-js/tree/main/packages/laya-router",
  "bugs": {
    "url": "https://github.com/johnhenry/laya-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/laya-js.git",
    "directory": "packages/laya-router"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/rewrite-dts-extensions.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --conditions=source --test test/*.test.ts",
    "test:bun": "bun --conditions=source test test/"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@johnhenry/langdetect-lite": "^0.1.1",
    "@johnhenry/laya": "^0.3.0",
    "@johnhenry/laya-core": "^0.1.1",
    "@johnhenry/pyjson": "^0.1.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
