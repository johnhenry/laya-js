{
  "name": "@johnhenry/backend-webgpu",
  "version": "0.0.0",
  "description": "WebGPU (WGSL, f16) backend for @johnhenry/tensor-backend in browsers and Node/Bun via Dawn",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#dawn": {
      "browser": {
        "source": "./src/dawn-browser.ts",
        "types": "./dist/dawn-browser.d.ts",
        "default": "./dist/dawn-browser.js"
      },
      "source": "./src/dawn-node.ts",
      "types": "./dist/dawn-node.d.ts",
      "default": "./dist/dawn-node.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/rewrite-dts-extensions.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --conditions=source --test test/*.test.ts",
    "test:bun": "bun --conditions=source test test/",
    "demo:build": "bun build demo/main.ts --outdir demo/dist --target browser --conditions source",
    "bench": "node --conditions=source bench/gemm.ts",
    "test:deno": "deno test -A --conditions=source --node-modules-dir=manual test/"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.74",
    "@johnhenry/tensor-backend": "^0.0.0",
    "webgpu": "^0.6.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/laya-js.git",
    "directory": "packages/backend-webgpu"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/johnhenry/laya-js/tree/main/packages/backend-webgpu",
  "keywords": [
    "webgpu",
    "wgsl",
    "gpu",
    "f16",
    "tensor",
    "transformer",
    "inference",
    "dawn",
    "browser"
  ],
  "bugs": {
    "url": "https://github.com/johnhenry/laya-js/issues"
  }
}
