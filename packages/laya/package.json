{
  "name": "@johnhenry/laya",
  "version": "0.0.0",
  "description": "Laya typed decisions in JavaScript on MLX, WebGPU or CPU",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#io": {
      "browser": {
        "source": "./src/io-browser.ts",
        "types": "./dist/io-browser.d.ts",
        "default": "./dist/io-browser.js"
      },
      "source": "./src/io-node.ts",
      "types": "./dist/io-node.d.ts",
      "default": "./dist/io-node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --conditions=source --test test/*.test.ts",
    "test:bun": "bun --conditions=source test test/"
  },
  "dependencies": {
    "@johnhenry/backend-cpu": "^0.0.0",
    "@johnhenry/hf-cache": "^0.0.0",
    "@johnhenry/laya-core": "^0.0.0",
    "@johnhenry/math-plus-safetensors": "file:../../../@johnhenry/math-plus.worktrees/f16-safetensors/packages/safetensors",
    "@johnhenry/modernbert": "^0.0.0",
    "@johnhenry/pyjson": "^0.0.0",
    "@johnhenry/tensor-backend": "^0.0.0"
  },
  "peerDependencies": {
    "@johnhenry/backend-mlx": "^0.0.0",
    "@johnhenry/backend-webgpu": "^0.0.0"
  },
  "peerDependenciesMeta": {
    "@johnhenry/backend-mlx": {
      "optional": true
    },
    "@johnhenry/backend-webgpu": {
      "optional": true
    }
  },
  "devDependencies": {
    "@johnhenry/backend-mlx": "^0.0.0",
    "@johnhenry/backend-webgpu": "^0.0.0",
    "@johnhenry/laya-fixtures": "^0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/laya-js.git",
    "directory": "packages/laya"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/johnhenry/laya-js/tree/main/packages/laya"
}
