{
  "name": "@johnhenry/laya",
  "version": "0.2.1",
  "description": "Laya typed decisions in JavaScript on MLX, WebGPU or CPU",
  "keywords": [
    "laya",
    "typed-decisions",
    "classification",
    "modernbert",
    "mlx",
    "webgpu",
    "inference",
    "llm-alternative"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/johnhenry/laya-js/tree/main/packages/laya",
  "bugs": {
    "url": "https://github.com/johnhenry/laya-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/laya-js.git",
    "directory": "packages/laya"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#io": {
      "browser": {
        "source": "./src/io-browser.ts",
        "types": "./dist/io-browser.d.ts",
        "default": "./dist/io-browser.js"
      },
      "source": "./src/io-node.ts",
      "types": "./dist/io-node.d.ts",
      "default": "./dist/io-node.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/rewrite-dts-extensions.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --conditions=source --test test/*.test.ts",
    "test:bun": "bun --conditions=source test test/"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@johnhenry/backend-cpu": "^0.3.0",
    "@johnhenry/hf-cache": "^0.1.2",
    "@johnhenry/laya-core": "^0.1.1",
    "@johnhenry/math-plus-safetensors": "^0.1.0",
    "@johnhenry/modernbert": "^0.2.0",
    "@johnhenry/pyjson": "^0.1.2",
    "@johnhenry/tensor-backend": "^0.2.0"
  },
  "peerDependencies": {
    "@johnhenry/backend-mlx": "^0.2.0 || ^0.3.0",
    "@johnhenry/backend-webgpu": "^0.2.0 || ^0.3.0"
  },
  "peerDependenciesMeta": {
    "@johnhenry/backend-mlx": {
      "optional": true
    },
    "@johnhenry/backend-webgpu": {
      "optional": true
    }
  },
  "devDependencies": {
    "@johnhenry/backend-mlx": "^0.3.0",
    "@johnhenry/backend-webgpu": "^0.3.0",
    "@johnhenry/laya-fixtures": "^0.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
