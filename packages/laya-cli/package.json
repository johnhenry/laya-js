{
  "name": "@johnhenry/laya-cli",
  "version": "0.1.2",
  "description": "laya predict / laya bench command line",
  "keywords": [
    "laya",
    "cli",
    "typed-decisions",
    "mlx",
    "webgpu",
    "benchmark"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/johnhenry/laya-js/tree/main/packages/laya-cli",
  "bugs": {
    "url": "https://github.com/johnhenry/laya-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/laya-js.git",
    "directory": "packages/laya-cli"
  },
  "type": "module",
  "bin": {
    "laya": "./bin/laya.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "bin",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/rewrite-dts-extensions.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --conditions=source --test test/*.test.ts",
    "test:bun": "bun --conditions=source test test/"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@johnhenry/laya": "^0.1.2",
    "@johnhenry/laya-router": "^0.1.2",
    "@johnhenry/pyjson": "^0.1.2"
  },
  "peerDependencies": {
    "@johnhenry/backend-mlx": "^0.0.0 || ^0.1.0 || ^0.2.0",
    "@johnhenry/backend-webgpu": "^0.0.0 || ^0.1.0 || ^0.2.0"
  },
  "peerDependenciesMeta": {
    "@johnhenry/backend-mlx": {
      "optional": true
    },
    "@johnhenry/backend-webgpu": {
      "optional": true
    }
  },
  "devDependencies": {
    "@johnhenry/laya-fixtures": "^0.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
