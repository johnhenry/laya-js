{
  "name": "@johnhenry/backend-cpu",
  "version": "0.3.0",
  "description": "Deprecated alias: re-exports @johnhenry/math-plus-tensor-cpu, the f32 CPU reference backend for @johnhenry/tensor-backend",
  "keywords": [
    "tensor",
    "cpu",
    "reference",
    "transformer",
    "inference",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/johnhenry/laya-js/tree/main/packages/backend-cpu",
  "bugs": {
    "url": "https://github.com/johnhenry/laya-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/laya-js.git",
    "directory": "packages/backend-cpu"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/rewrite-dts-extensions.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --conditions=source --test test/*.test.ts",
    "test:bun": "bun --conditions=source test test/"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@johnhenry/math-plus-tensor-cpu": "^0.1.0",
    "@johnhenry/tensor-backend": "^0.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
