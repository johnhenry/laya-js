{
  "name": "@johnhenry/laya-core",
  "version": "0.0.0",
  "description": "Tensor-free Laya typed-decision logic: prompts, collation, calibration, result formatting",
  "keywords": [
    "laya",
    "typed-decisions",
    "prompts",
    "tokenizer",
    "calibration",
    "isomorphic"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/johnhenry/laya-js/tree/main/packages/laya-core",
  "bugs": {
    "url": "https://github.com/johnhenry/laya-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/laya-js.git",
    "directory": "packages/laya-core"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/rewrite-dts-extensions.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --conditions=source --test test/*.test.ts",
    "test:bun": "bun --conditions=source test test/"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "@johnhenry/pyjson": "^0.0.0"
  },
  "devDependencies": {
    "@johnhenry/laya-fixtures": "^0.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
