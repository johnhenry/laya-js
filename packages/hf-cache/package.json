{
  "name": "@johnhenry/hf-cache",
  "version": "0.1.2",
  "description": "Resolve and cache Hugging Face Hub files: ~/.cache/huggingface layout on Node/Bun, Cache API/OPFS in browsers",
  "keywords": [
    "huggingface",
    "hugging-face",
    "hub",
    "cache",
    "download",
    "models",
    "browser",
    "opfs"
  ],
  "license": "MIT",
  "homepage": "https://github.com/johnhenry/laya-js/tree/main/packages/hf-cache",
  "bugs": {
    "url": "https://github.com/johnhenry/laya-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/laya-js.git",
    "directory": "packages/hf-cache"
  },
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "source": "./src/browser.ts",
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/rewrite-dts-extensions.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --conditions=source --test test/*.test.ts",
    "test:bun": "bun --conditions=source test test/"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
