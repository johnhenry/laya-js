{
  "name": "@johnhenry/laya-fixtures",
  "version": "0.0.0",
  "private": true,
  "description": "Golden fixtures generated from Python laya-mlx (private)",
  "keywords": [
    "laya",
    "fixtures"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/johnhenry/laya-js/tree/main/packages/laya-fixtures",
  "bugs": {
    "url": "https://github.com/johnhenry/laya-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/laya-js.git",
    "directory": "packages/laya-fixtures"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data/*": "./data/*"
  },
  "files": [
    "dist",
    "data"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/rewrite-dts-extensions.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "npm run typecheck && node --conditions=source --test test/*.test.ts",
    "test:bun": "bun --conditions=source test test/"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.2.0"
  }
}
